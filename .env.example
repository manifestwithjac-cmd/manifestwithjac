# THE UNIVERSE IS CALLING — environment variables (Netlify site settings)
#
# Copy this into your Netlify site's Environment Variables (Site settings ->
# Environment variables) — NOT into a committed .env file. Netlify Functions
# read these via process.env at request time.
#
# The tag/sequence IDs below are the REAL ids already created in the live
# "Manifest With Jac" Kit account for this project (created via the Kit API
# while building this — see KIT_SETUP.md). You do not need to recreate them.
# The one thing only you can provide is KIT_API_KEY.

# ---- Required ----

# Kit (formerly ConvertKit) V4 API key. Create it yourself:
# Kit -> Account Settings -> Developer -> API Keys -> "New API Key".
# IMPORTANT: this must be a V4 key. V3 keys/secrets do NOT work with this integration.
KIT_API_KEY=PLACEHOLDER_GET_FROM_KIT_DEVELOPER_SETTINGS

# ---- Kit tag ids (already created — see KIT_SETUP.md) ----
KIT_TAG_UIC_COMPLETED=22755139
KIT_TAG_MONEY_SURGE=22755140
KIT_TAG_SOLD_OUT_ERA=22755141
KIT_TAG_GLOW_UP=22755142
KIT_TAG_MAGNETIC_ERA=22755143
KIT_TAG_LOVE_UPGRADE=22755144
KIT_TAG_LUCK_STREAK=22755145
KIT_TAG_LIFE_UPGRADE=22755146

# ---- Kit sequence ids (already created — see KIT_SETUP.md) ----
# The app enrolls a subscriber directly into these via the Kit v4 API
# (POST /v4/sequences/{id}/subscribers) — no manual "automation" needed.
KIT_SEQUENCE_MONEY_SURGE=2872952
KIT_SEQUENCE_SOLD_OUT_ERA=2872953
KIT_SEQUENCE_GLOW_UP=2872954
KIT_SEQUENCE_MAGNETIC_ERA=2872955
KIT_SEQUENCE_LOVE_UPGRADE=2872956
KIT_SEQUENCE_LUCK_STREAK=2872957
KIT_SEQUENCE_LIFE_UPGRADE=2872958

# ---- Optional ----
# Netlify Blobs (lead log + Kit-retry queue) needs no env vars — Netlify
# provisions it automatically per-site. Nothing to set here for it.
